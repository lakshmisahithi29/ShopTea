{
  "name": "shoptea-backend",
  "version": "1.0.0",
  "description": "Production-ready backend API for ShopTea inventory management",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "tsx --test src/tests/auth.test.ts src/tests/shop.test.ts src/tests/dashboard.test.ts src/tests/inventory.test.ts src/tests/purchase.test.ts src/tests/sales.test.ts src/tests/alerts.test.ts src/tests/reports.test.ts src/tests/forecasts.test.ts",
    "test:phase3": "tsx --test src/tests/dashboard.test.ts",
    "test:phase4": "tsx --test src/tests/inventory.test.ts",
    "test:phase5": "tsx --test src/tests/purchase.test.ts",
    "test:phase6": "tsx --test src/tests/sales.test.ts",
    "test:phase7": "tsx --test src/tests/alerts.test.ts",
    "test:phase8": "tsx --test src/tests/reports.test.ts",
    "test:phase9": "tsx --test src/tests/forecasts.test.ts",
    "prisma:generate": "node prisma-cli.cjs generate",
    "prisma:migrate": "node prisma-cli.cjs migrate dev",
    "prisma:deploy": "node prisma-cli.cjs migrate deploy",
    "prisma:status": "node prisma-cli.cjs migrate status",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
