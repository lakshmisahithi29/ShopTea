# Application Configuration
PORT=5000
NODE_ENV=development
# Exact frontend origin only, with no trailing slash (for example https://shoptea.vercel.app).
CLIENT_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# Get a free Neon PostgreSQL connection string at https://neon.tech
DATABASE_URL="postgresql://[user]:[password]@[neon-host]/shoptea?sslmode=require"
# Direct (non-pooled) connection – required for Prisma migrations
DATABASE_URL_UNPOOLED="postgresql://[user]:[password]@[neon-host]/shoptea?sslmode=require"

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a unique random value of at least 32 characters for every production environment.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# ─── Session Cookie ────────────────────────────────────────────────────────────
# Cross-site Vercel + Render hosting requires none; the API also sets Secure in production.
# Use lax or strict when frontend and API are served from the same origin.
COOKIE_SAME_SITE=lax

# Optional local seed account only. Never use these values in production.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=replace_with_a_strong_local_password
